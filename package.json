{
  "name": "@rornellas/ng2-smart-table",
  "version": "1.6.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:demo": "ng build demo --aot --prod",
    "build:lib": "ng build ng2-smart-table --prod",
    "build:ci": "npm run build:demo && npm run build:lib",
    "docs:gh-pages": "npm run build:demo -- --base-href '/ng2-smart-table/' && ngh --dir ./dist/demo",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "e2e": "ng e2e",
    "changelog": "standard-changelog -p angular",
    "prepublishOnly": "npm run validate",
    "validate": "node scripts/validate.js",
    "release": "npm run validate && npm run publish:safe",
    "release:force": "npm run build:lib && npm run publish:force",
    "release:dry": "npm run build:lib && npm publish --access=public --ignore-scripts --dry-run dist/ng2-smart-table",
    "publish": "npm publish --access=public --ignore-scripts dist/ng2-smart-table",
    "publish:force": "npm publish --access=public --ignore-scripts --no-git-checks dist/ng2-smart-table",
    "publish:safe": "npm publish --access=public --ignore-scripts --dry-run dist/ng2-smart-table && echo 'Dry run successful. Run without --dry-run to publish for real.'",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "clean": "rm -rf dist/",
    "clean:all": "rm -rf dist/ node_modules/ package-lock.json && npm install"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "~9.0.4",
    "@angular/common": "~9.0.4",
    "@angular/compiler": "~9.0.4",
    "@angular/core": "~9.0.4",
    "@angular/forms": "~9.0.4",
    "@angular/platform-browser": "~9.0.4",
    "@angular/platform-browser-dynamic": "~9.0.4",
    "@angular/router": "~9.0.4",
    "highlight.js": "^9.15.8",
    "lodash": "^4.17.10",
    "@akveo/ng2-completer": "9.0.1",
    "rxjs": "~6.5.4",
    "tslib": "^1.10.0",
    "zone.js": "~0.10.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.900.4",
    "@angular-devkit/build-ng-packagr": "~0.900.4",
    "@angular/cli": "~9.0.4",
    "@angular/compiler-cli": "~9.0.4",
    "@angular/language-service": "~9.0.4",
    "@types/jasmine": "~3.3.8",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^12.11.1",
    "angular-cli-ghpages": "^0.5.3",
    "codelyzer": "^5.1.2",
    "jasmine-core": "~3.4.0",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "~4.1.0",
    "karma-chrome-launcher": "~2.2.0",
    "karma-coverage-istanbul-reporter": "~2.0.1",
    "karma-jasmine": "~2.0.1",
    "karma-jasmine-html-reporter": "^1.4.0",
    "ng-packagr": "^9.0.0",
    "protractor": "~5.4.0",
    "standard-changelog": "^2.0.11",
    "ts-node": "~7.0.0",
    "tslint": "~5.15.0",
    "typescript": "~3.7.5"
  },
  "description": "[![Build Status](https://travis-ci.org/akveo/ng2-smart-table.svg?branch=master)](https://travis-ci.org/akveo/ng2-smart-table)",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rornellas/ng2-smart-table.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rornellas/ng2-smart-table/issues"
  },
  "homepage": "https://github.com/rornellas/ng2-smart-table#readme"
}
